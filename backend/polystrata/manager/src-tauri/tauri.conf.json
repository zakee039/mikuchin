{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyStrata Manager",
  "version": "0.1.12",
  "identifier": "fun.zakee.polystrata.manager",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PolyStrata Manager",
        "width": 440,
        "height": 650,
        "minWidth": 420,
        "minHeight": 650,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
